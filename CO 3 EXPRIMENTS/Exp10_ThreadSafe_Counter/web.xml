<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Exp10_ThreadSafe_Counter</display-name>
    <description>Experiment 10: Thread-Safe Concurrent Visitor Counter Using Servlet</description>

    <!-- Unsafe Counter Servlet -->
    <servlet>
        <servlet-name>UnsafeCounterServlet</servlet-name>
        <servlet-class>com.lab.co3.UnsafeCounterServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>UnsafeCounterServlet</servlet-name>
        <url-pattern>/unsafe-counter</url-pattern>
    </servlet-mapping>

    <!-- Thread-Safe Counter Servlet -->
    <servlet>
        <servlet-name>ThreadSafeCounterServlet</servlet-name>
        <servlet-class>com.lab.co3.ThreadSafeCounterServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>ThreadSafeCounterServlet</servlet-name>
        <url-pattern>/threadsafe-counter</url-pattern>
    </servlet-mapping>

</web-app>
