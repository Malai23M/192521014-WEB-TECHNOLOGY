<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Exp9_Servlet_Lifecycle</display-name>
    <description>Experiment 9: Servlet Lifecycle Demonstration</description>

    <servlet>
        <servlet-name>LifecycleServlet</servlet-name>
        <servlet-class>com.lab.co3.LifecycleServlet</servlet-class>
        <init-param>
            <param-name>appName</param-name>
            <param-value>Lifecycle Monitoring Service</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>

    <servlet-mapping>
        <servlet-name>LifecycleServlet</servlet-name>
        <url-pattern>/lifecycle</url-pattern>
    </servlet-mapping>

</web-app>
